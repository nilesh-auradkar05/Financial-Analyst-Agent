  "cards": [
    {
      "dot": "cyan",
      "title": "Ordering that protects correctness",
      "items": [
        "The snapshot is frozen before any model call, so every citation and the memo-cache key refer to evidence that cannot change",
        "Memory is written only after the fenced commit, so a stale attempt never leaves a record for a discarded result",
        "No partial draft is ever spliced when the provider ladder moves to the next tier"
      ]
    },
    {
      "dot": "emerald",
      "title": "Where calls are saved",
      "items": [
        "C3 collapses tool calls per TTL window during a burst",
        "C1 collapses identical snapshots to one generation (single-flight)",
        "C8 means a cached memo is never re-verified"
      ]
    },
    {
      "dot": "rose",
      "title": "Crash and resume",
      "items": [
        "A re-claimed attempt skips completed, in-TTL specialists and reuses the memo cache",
        "Every commit and memory write carries the attempt fence",
        "Exactly one attempt's result is stored; a duplicated model call is recorded as cost, never as a second result"
      ]
    }
  ]
