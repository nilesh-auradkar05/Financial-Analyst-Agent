  "cards": [
    {
      "dot": "cyan",
      "title": "Containment in the types",
      "items": [
        "Market, News and Filings hold a non-empty allowlist and never a model client",
        "Analyst and Verifier hold an empty allowlist: a tool call cannot be expressed",
        "ToolSpec.side_effects is the literal 'none', so a writing tool cannot be registered"
      ]
    },
    {
      "dot": "violet",
      "title": "Memory contract and adapters",
      "items": [
        "IssuerProfile has no principal field by construction; EpisodicRecord stores a memo reference, never the memo text",
        "forget(principal) backs DELETE /memory",
        "Adapters: InMemoryMemoryStore (tests), DynamoDBMemoryStore (demo tier, DynamoDB Local in compose); Postgres only at its scale-tier trigger"
      ]
    },
    {
      "dot": "amber",
      "title": "Dependency rules",
      "items": [
        "specialists → gateway, memory protocol; never a client",
        "mcp_client.py is the only module importing the MCP SDK",
        "RunContext (job_id, attempt, customer_id, deadline, correlation ids) is built per attempt by the Supervisor and passed to every run()"
      ]
    }
  ]
