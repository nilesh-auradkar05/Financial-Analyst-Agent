  "cards": [
    {
      "dot": "rose",
      "title": "Threats and controls",
      "items": [
        "Tool poisoning / rug-pull: schema and description hashes pinned; drift disables the tool until re-approved",
        "Server-initiated model calls: sampling and elicitation refused by the client",
        "Injection through payloads: output-schema validation, framing as data, only model-free specialists receive payloads"
      ]
    },
    {
      "dot": "cyan",
      "title": "Adoption order",
      "items": [
        "MCP-0 gateway with in-process tools only; tool_calls log in the release manifest",
        "MCP-1 news-search behind a flag with a paired evidence-equality check",
        "MCP-2 sec-edgar wrapper; MCP-3 expose /mcp; MCP-4 market-data wrapper"
      ]
    },
    {
      "dot": "amber",
      "title": "Replay and cost",
      "items": [
        "A replay asserts the same tool, schema_hash and args_hash list, not only the same memo",
        "Own wrappers are two idle-free functions in the demo tier or two small tasks in the scale tier",
        "Credentials per server live in Parameter Store; the worker role gains no permission"
      ]
    }
  ]
