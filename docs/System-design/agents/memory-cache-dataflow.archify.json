  "cards": [
    {
      "dot": "emerald",
      "title": "Citable path",
      "items": [
        "Only packets frozen into the snapshot enter the citation registry",
        "The memo-cache key is the snapshot hash plus prompt, model and verifier fingerprints",
        "C1 is written only after verification passes, so a cached memo is always a verified memo"
      ]
    },
    {
      "dot": "rose",
      "title": "Memory is context only",
      "items": [
        "Issuer profile and episodic records reach the analyst in an uncited MEMORY block",
        "The verifier rejects a claim whose only support is memory",
        "Replay reuses the items recorded in memory_ref and never reads live memory"
      ]
    },
    {
      "dot": "violet",
      "title": "Writes, lifetimes and tool caches",
      "items": [
        "Memory writes follow the fenced commit and are idempotent on job_id; the same two stores are read at the start and written at the end",
        "Issuer profiles live until a newer accession; episodic records 90 days, guests 24 h; procedural memory changes only offline through the eval registry",
        "Tool caches C2–C6 (tags on the specialists) share the one cache store with fingerprinted keys"
      ]
    }
  ]
