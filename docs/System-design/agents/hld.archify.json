  "cards": [
    {
      "dot": "cyan",
      "title": "Containment rule",
      "items": [
        "market, news and filings make no model call; analyst and verifier call no tool",
        "The supervisor is code: its only data-dependent branch is the revise loop",
        "Tool payloads are framed as data before any model sees them"
      ]
    },
    {
      "dot": "violet",
      "title": "Memory is context, never evidence",
      "items": [
        "The supervisor reads the issuer profile before fan-out and episodic memory before drafting; it writes episodic memory only after the fenced commit",
        "Memory items carry no citation index; the verifier rejects memory-only claims; the manifest records memory_ref for replay",
        "Episodic memory is keyed by customer_id; guests expire after 24 h"
      ]
    },
    {
      "dot": "emerald",
      "title": "One cache store, nine stages",
      "items": [
        "C0 idempotency · C1 memo (single-flight) · C2–C6 tool, embedding, retrieval, sentiment",
        "C7 provider prompt prefix · C8 verification · C9 issuer profile",
        "Every key carries the fingerprint of what produced it; semantic memo reuse stays prohibited"
      ]
    },
    {
      "dot": "amber",
      "title": "What does not change, and what comes later",
      "items": [
        "Acceptance, fencing, event replay and identity stay as ADR-0010, ADR-0013 and ADR-0015 define them",
        "A third server, market-data (own wrapper, MCP-4), joins the MCP group when licensed data arrives",
        "The pre-revision graph stays the default until Gate F passes a paired comparison on the frozen release"
      ]
    }
  ]
