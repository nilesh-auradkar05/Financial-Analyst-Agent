  "cards": [
    {
      "dot": "emerald",
      "title": "Terminal precedence",
      "items": [
        "failed › evidence_missing › degraded › completed (SPEC §8.5)",
        "completed needs passing verification, output policy and no missing evidence class",
        "Every terminal write carries the attempt fence; a C1 hit is verified from C8, never re-drafted"
      ]
    },
    {
      "dot": "rose",
      "title": "Bounded loops and crashes",
      "items": [
        "Revise at most twice, then degraded; 'no tier' means every provider tier failed or the cost cap was hit",
        "A crash expires the lease: the job is redelivered and re-claimed with attempt + 1 (at most three attempts, then the DLQ writes failed)",
        "A re-claim skips completed, in-TTL specialists and the memo cache answers for the same snapshot_hash"
      ]
    },
    {
      "dot": "violet",
      "title": "Memory touches",
      "items": [
        "Claim = attempt + 1 with a lease, then guard_inputs and the issuer-profile read, before the evidence fan-out",
        "Episodic memory is read before drafting and written only after the fenced terminal commit",
        "A memory outage records memory_unavailable and continues"
      ]
    }
  ]
}
