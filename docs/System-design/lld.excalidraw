   "fontFamily": 3,
   "text": "@dataclass(frozen=True)\nclass EvidencePacket:\n    evidence_id: str          # chunk_id | url | quote key\n    kind: Literal['sec','news','market','sentiment']\n    section_key: str | None\n    accession_number: str | None\n    text: str\n    as_of: datetime\n\n@dataclass(frozen=True)\nclass EvidenceSnapshot:\n    packets: tuple[EvidencePacket, ...]\n    manifest: SourceManifest\n    @property\n    def snapshot_hash(self) -> str:\n        return sha256(canonical_json(self)).hexdigest()",
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "@dataclass(frozen=True)\nclass EvidencePacket:\n    evidence_id: str          # chunk_id | url | quote key\n    kind: Literal['sec','news','market','sentiment']\n    section_key: str | None\n    accession_number: str | None\n    text: str\n    as_of: datetime\n\n@dataclass(frozen=True)\nclass EvidenceSnapshot:\n    packets: tuple[EvidencePacket, ...]\n    manifest: SourceManifest\n    @property\n    def snapshot_hash(self) -> str:\n        return sha256(canonical_json(self)).hexdigest()",
   "lineHeight": 1.4
  },
