   "fontSize": 13,
   "fontFamily": 3,
   "text": "class RetrievalStore(Protocol):\n    def upsert_documents(self, docs: list[Chunk]) -> None: ...\n    def search(self, q: str, k: int, flt: Filter | None) -> list[Hit]: ...\n    def delete_by_filter(self, flt: Filter) -> int: ...\n    def healthcheck(self) -> StoreHealth: ...\n\nclass JobQueue(Protocol):\n    def enqueue(self, job: Job, idempotency_key: str) -> JobId: ...\n    def claim(self, consumer: str, block_ms: int) -> Job | None: ...\n    def ack(self, job_id: JobId) -> None: ...\n    def dead_letter(self, job_id: JobId, reason: str) -> None: ...\n\nclass RunStore(Protocol):\n    def create(self, run: Run) -> RunId: ...\n    def patch(self, run_id: RunId, **fields) -> None: ...   # row-level\n    def get(self, run_id: RunId) -> Run | None: ...",
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "class RetrievalStore(Protocol):\n    def upsert_documents(self, docs: list[Chunk]) -> None: ...\n    def search(self, q: str, k: int, flt: Filter | None) -> list[Hit]: ...\n    def delete_by_filter(self, flt: Filter) -> int: ...\n    def healthcheck(self) -> StoreHealth: ...\n\nclass JobQueue(Protocol):\n    def enqueue(self, job: Job, idempotency_key: str) -> JobId: ...\n    def claim(self, consumer: str, block_ms: int) -> Job | None: ...\n    def ack(self, job_id: JobId) -> None: ...\n    def dead_letter(self, job_id: JobId, reason: str) -> None: ...\n\nclass RunStore(Protocol):\n    def create(self, run: Run) -> RunId: ...\n    def patch(self, run_id: RunId, **fields) -> None: ...   # row-level\n    def get(self, run_id: RunId) -> Run | None: ...",
   "lineHeight": 1.4
  },
  {
