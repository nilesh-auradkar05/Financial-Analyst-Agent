   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "fontSize": 13,
   "fontFamily": 3,
   "text": "Kafka buys replayable multi-consumer streams. With one consumer and\ntens of jobs per minute it buys brokers, partitions and rebalance bugs.\nThe documented trigger keeps the decision honest and reversible.",
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "Kafka buys replayable multi-consumer streams. With one consumer and\ntens of jobs per minute it buys brokers, partitions and rebalance bugs.\nThe documented trigger keeps the decision honest and reversible.",
   "lineHeight": 1.35
  },
