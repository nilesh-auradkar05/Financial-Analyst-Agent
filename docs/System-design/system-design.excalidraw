   "textAlign": "center",
   "verticalAlign": "middle",
   "containerId": "bn_llm",
   "originalText": "LLM\nthe bottleneck\nby design",
   "lineHeight": 1.3
  },
  {
   "id": "bn_n",
   "type": "text",
   "x": 1320,
   "y": 1300,
   "width": 620,
   "height": 20,
   "angle": 0,
   "strokeColor": "#495057",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 84253,
   "version": 1,
   "versionNonce": 1,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "fontSize": 13,
   "fontFamily": 3,
   "text": "Everything left of the red box scales by adding processes.\nThe LLM does not: it is rate-limited, cached on snapshot_hash,\ncircuit-broken to Ollama, and priced per token.\nAdding workers past the TPM budget only grows the queue.",
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "Everything left of the red box scales by adding processes.\nThe LLM does not: it is rate-limited, cached on snapshot_hash,\ncircuit-broken to Ollama, and priced per token.\nAdding workers past the TPM budget only grows the queue.",
   "lineHeight": 1.35
  },
