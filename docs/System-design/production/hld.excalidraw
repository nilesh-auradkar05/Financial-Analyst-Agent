   "fontSize": 11,
   "fontFamily": 3,
   "text": "POST /collections/evidence/points/query\n{ \"prefetch\": [\n    {\"query\": [..1024 f32], \"using\": \"dense\", \"limit\": 40},\n    {\"query\": {\"indices\": [..], \"values\": [..]},\n     \"using\": \"bm25\", \"limit\": 40} ],\n  \"query\": {\"fusion\": \"rrf\"},  \"limit\": 50,\n  \"filter\": {\"must\": [\n    {\"key\": \"ticker\",      \"match\": {\"value\": \"AAPL\"}},\n    {\"key\": \"section_key\", \"match\": {\"any\": [\"risk_factors\",\"mdna\"]}},\n    {\"key\": \"filing_date\", \"range\": {\"gte\": \"2024-01-01\"}} ]},\n  \"shard_key\": \"AAPL\" }\n\n50 fused candidates  →  cross-encoder  →  top 8      ≈ 40 ms + 120 ms",
   "originalText": "POST /collections/evidence/points/query\n{ \"prefetch\": [\n    {\"query\": [..1024 f32], \"using\": \"dense\", \"limit\": 40},\n    {\"query\": {\"indices\": [..], \"values\": [..]},\n     \"using\": \"bm25\", \"limit\": 40} ],\n  \"query\": {\"fusion\": \"rrf\"},  \"limit\": 50,\n  \"filter\": {\"must\": [\n    {\"key\": \"ticker\",      \"match\": {\"value\": \"AAPL\"}},\n    {\"key\": \"section_key\", \"match\": {\"any\": [\"risk_factors\",\"mdna\"]}},\n    {\"key\": \"filing_date\", \"range\": {\"gte\": \"2024-01-01\"}} ]},\n  \"shard_key\": \"AAPL\" }\n\n50 fused candidates  →  cross-encoder  →  top 8      ≈ 40 ms + 120 ms",
