   "link": null,
   "locked": false,
   "fontSize": 13,
   "fontFamily": 3,
   "text": "COLLECTION SCHEMA  ·  Qdrant  ·  the tenant index is the whole scaling story",
   "originalText": "COLLECTION SCHEMA  ·  Qdrant  ·  the tenant index is the whole scaling story",
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25
  },
  {
   "id": "schema",
   "type": "rectangle",
   "x": 60,
   "y": 170,
   "width": 560,
   "height": 375,
   "angle": 0,
   "strokeColor": "#1e293b",
   "backgroundColor": "#1e293b",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": {
    "type": 3
   },
   "seed": 1004,
