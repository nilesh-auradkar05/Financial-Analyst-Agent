   "fontSize": 11,
   "fontFamily": 3,
   "text": "jobs              (id, customer_id, request_hash, state, priority,\n                   attempt  -- fencing token, lease_until,\n                   snapshot_hash, result_ref, created_at)\njob_events        (job_id, seq, type, payload, at)    pk (job_id, seq)\nidempotency_keys  (customer_id, key, request_hash, job_id)\n                                                  pk (customer_id, key)\ncustomers         (id, cognito_sub, role, token_quota, job_quota)\nruns              (job_id, model_fp, verifier_policy_fp,\n                   evidence_release, usage)\noutbox            (id, job_id, dispatched_at)   -- only after SQS trigger\n-- demo tier: same contracts as DynamoDB items (ADR-0015)\n\naccept = one txn: key + job + event #1   ·   key reuse, new hash ⇒ 409",
   "originalText": "jobs              (id, customer_id, request_hash, state, priority,\n                   attempt  -- fencing token, lease_until,\n                   snapshot_hash, result_ref, created_at)\njob_events        (job_id, seq, type, payload, at)    pk (job_id, seq)\nidempotency_keys  (customer_id, key, request_hash, job_id)\n                                                  pk (customer_id, key)\ncustomers         (id, cognito_sub, role, token_quota, job_quota)\nruns              (job_id, model_fp, verifier_policy_fp,\n                   evidence_release, usage)\noutbox            (id, job_id, dispatched_at)   -- only after SQS trigger\n-- demo tier: same contracts as DynamoDB items (ADR-0015)\n\naccept = one txn: key + job + event #1   ·   key reuse, new hash ⇒ 409",
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25
