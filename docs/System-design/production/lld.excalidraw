   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "fontSize": 10,
   "fontFamily": 3,
   "text": "why market is bucketed to 15 min: without it the snapshot_hash changes every 60 s and the MemoCache\ncan never hit during an earnings-day burst. The raw 60 s quote still appears in the memo header.",
   "originalText": "why market is bucketed to 15 min: without it the snapshot_hash changes every 60 s and the MemoCache\ncan never hit during an earnings-day burst. The raw 60 s quote still appears in the memo header.",
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25
  },
