   "locked": false,
   "fontSize": 14,
   "fontFamily": 3,
   "text": "Numbers, not adjectives. Each panel is what an engineer would actually type.  All of it hangs off two keys: collection_version[ticker] for retrieval, snapshot_hash for generation.",
   "originalText": "Numbers, not adjectives. Each panel is what an engineer would actually type.  All of it hangs off two keys: collection_version[ticker] for retrieval, snapshot_hash for generation.",
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25
  },
  {
   "id": "h_schema",
   "type": "text",
