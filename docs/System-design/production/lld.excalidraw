    {
      "id": "schema_t",
      "type": "text",
      "x": 74,
      "y": 182,
      "width": 419.375,
      "height": 343.75,
      "angle": 0,
      "strokeColor": "#22c55e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 1005,
      "version": 2,
      "versionNonce": 1005,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "fontSize": 11,
      "fontFamily": 3,
      "text": "PUT /collections/evidence_v17\n{\n  \"vectors\": {\n    \"dense\": {\"size\": 1024, \"distance\": \"Cosine\",\n      \"datatype\": \"float16\", \"on_disk\": true}},\n  \"sparse_vectors\": {\n    \"bm25\": {\"modifier\": \"idf\", \"index\": {\"on_disk\": true}}},\n  \"hnsw_config\": {\"m\": 16, \"ef_construct\": 128},\n  \"quantization_config\": {\n    \"scalar\": {\"type\": \"int8\", \"always_ram\": true}},\n  \"shard_number\": 12, \"replication_factor\": 2,\n  \"sharding_method\": \"auto\", \"on_disk_payload\": true\n}\n\nPayload indexes (one call per field):\n  cik               keyword  (issuer; NOT customer)\n  filing_type       keyword\n  section_key       keyword\n  fiscal_year       integer\n  filing_date       datetime\n  accession_number  keyword\n\n12 logical shards TOTAL; RF 2 => 24 shard replicas.\nIssuer filters narrow candidates; queries may fan out.\nCustom shard_number would be PER KEY. Avoid 8k keys.",
      "originalText": "PUT /collections/evidence_v17\n{\n  \"vectors\": {\n    \"dense\": {\"size\": 1024, \"distance\": \"Cosine\",\n      \"datatype\": \"float16\", \"on_disk\": true}},\n  \"sparse_vectors\": {\n    \"bm25\": {\"modifier\": \"idf\", \"index\": {\"on_disk\": true}}},\n  \"hnsw_config\": {\"m\": 16, \"ef_construct\": 128},\n  \"quantization_config\": {\n    \"scalar\": {\"type\": \"int8\", \"always_ram\": true}},\n  \"shard_number\": 12, \"replication_factor\": 2,\n  \"sharding_method\": \"auto\", \"on_disk_payload\": true\n}\n\nPayload indexes (one call per field):\n  cik               keyword  (issuer; NOT customer)\n  filing_type       keyword\n  section_key       keyword\n  fiscal_year       integer\n  filing_date       datetime\n  accession_number  keyword\n\n12 logical shards TOTAL; RF 2 => 24 shard replicas.\nIssuer filters narrow candidates; queries may fan out.\nCustom shard_number would be PER KEY. Avoid 8k keys.",
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "lineHeight": 1.25
    },
