   "fontSize": 11,
   "fontFamily": 3,
   "text": "class Reranker(Protocol):\n    def rerank(self, q: str, docs: list[Chunk], k: int) -> list[Scored]: ...\nclass LLMProvider(Protocol):\n    def stream(self, req: DraftRequest) -> AsyncIterator[Token]: ...\n    def health(self) -> ProviderHealth: ...\nclass RetrievalCache(Protocol):\n    def get(self, key: RetrievalKey) -> list[EvidencePacket] | None: ...\n    def set(self, key: RetrievalKey, packets, ttl_s: int) -> None: ...\n# JobQueue / RunStore / RetrievalStore unchanged (Redis Streams, Postgres, Qdrant)",
   "originalText": "class Reranker(Protocol):\n    def rerank(self, q: str, docs: list[Chunk], k: int) -> list[Scored]: ...\nclass LLMProvider(Protocol):\n    def stream(self, req: DraftRequest) -> AsyncIterator[Token]: ...\n    def health(self) -> ProviderHealth: ...\nclass RetrievalCache(Protocol):\n    def get(self, key: RetrievalKey) -> list[EvidencePacket] | None: ...\n    def set(self, key: RetrievalKey, packets, ttl_s: int) -> None: ...\n# JobQueue / RunStore / RetrievalStore unchanged (Redis Streams, Postgres, Qdrant)",
   "textAlign": "left",
