   "fontSize": 11,
   "fontFamily": 3,
   "text": "# claim (worker) · conditional write, the DynamoDB form of a fencing token\nUpdateItem jobs[id] SET attempt = attempt + 1, state = running, lease_until = :t\n  IF state = queued OR (state = running AND lease_until < :now)\n# later writes: IF state = running AND attempt = :mine   -- fails ⇒ stale, discarded",
   "originalText": "# claim (worker) · conditional write, the DynamoDB form of a fencing token\nUpdateItem jobs[id] SET attempt = attempt + 1, state = running, lease_until = :t\n  IF state = queued OR (state = running AND lease_until < :now)\n# later writes: IF state = running AND attempt = :mine   -- fails ⇒ stale, discarded",
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25
  },
