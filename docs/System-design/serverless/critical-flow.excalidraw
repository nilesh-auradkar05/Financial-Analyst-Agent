   "updated": 1,
   "link": null,
   "locked": false,
   "fontSize": 11,
   "fontFamily": 3,
   "text": "the warm-up runs when Turnstile passes on the landing page, so search resume and FinBERT loading overlap with the visitor reading and typing.\nSnapStart would remove most init time but bills its snapshot cache while idle (≈ $11.70/month for the worker), so it is rejected.",
   "originalText": "the warm-up runs when Turnstile passes on the landing page, so search resume and FinBERT loading overlap with the visitor reading and typing.\nSnapStart would remove most init time but bills its snapshot cache while idle (≈ $11.70/month for the worker), so it is rejected.",
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25
  },
