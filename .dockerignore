# Backend image context only (root of repository).
.git/
.gitignore
.github/
.idea/
.vscode/
*.swp
*.swo
.DS_Store

# Local Python environments, build products and tooling.
**/.venv/
**/venv/
**/__pycache__/
**/*.py[cod]
**/*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.pyright/
.coverage
htmlcov/
.tox/
dist/
build/

# Local runtime data, embedding/model weights and generated artifacts.
data/
.runtime/
.cache/
**/.cache/
models/
checkpoints/
datasets/
outputs/
wandb/
mlruns/
**/*.db
**/*.sqlite
**/*.sqlite3
**/*.safetensors
**/*.ckpt
**/*.pth
**/*.pt
**/*.onnx
*.log

# Credentials and local overrides. Use runtime environment/secrets instead.
.env
.env.*
**/.env
**/.env.*
*.pem
*.key
*.p12
*.pfx

# The Next.js service and monitoring mounts are built/mounted separately.
frontend/
monitoring/

# Local-only files not needed to execute the API.
tests/
docs/
